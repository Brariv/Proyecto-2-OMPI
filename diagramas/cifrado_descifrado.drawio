    <diagram id="estrategia" name="Estrategia alternativa (heuristica + bloques)">
        <mxGraphModel dx="703" dy="691" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="T" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" value="BUSQUEDA DE LA CLAVE - Estrategia alternativa: Priorizacion heuristica, y bloques como respaldo" vertex="1">
                    <mxGeometry height="40" width="720" x="200" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="S0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Inicio:&#xa;mpirun -np 4 busqueda_mpi -s clave -e heuristica -t umbral" vertex="1">
                    <mxGeometry height="60" width="400" x="360" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="S1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="rank 0 cifra el mensaje con la clave secreta&#xa;y lo difunde (MPI_Bcast) a los 4 procesos" vertex="1">
                    <mxGeometry height="60" width="400" x="360" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="F1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" value="FASE 1 - Priorizacion heuristica (claves probables)" vertex="1">
                    <mxGeometry height="30" width="400" x="580" y="270" as="geometry"/>
                </mxCell>
                <mxCell id="S2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Cada proceso prueba SU parte del diccionario&#xa;(reparto por rondas: j = i*size + rank):&#xa;numeros cortos, potencias de 2 y vecinas, fechas, secuencias" vertex="1">
                    <mxGeometry height="80" width="440" x="340" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="S3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Algun proceso encontro la clave?&#xa;(Allreduce MIN al fin de ronda)" vertex="1">
                    <mxGeometry height="110" width="300" x="410" y="440" as="geometry"/>
                </mxCell>
                <mxCell id="S4" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Tiempo transcurrido &gt; umbral (-t)?&#xa;(rank 0 decide y avisa con Bcast)" vertex="1">
                    <mxGeometry height="110" width="300" x="410" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="S5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Quedan rondas del diccionario?" vertex="1">
                    <mxGeometry height="110" width="300" x="410" y="740" as="geometry"/>
                </mxCell>
                <mxCell id="F2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" value="FASE 2 - Distribucion por bloques contiguos (respaldo)" vertex="1">
                    <mxGeometry height="30" width="400" x="590" y="890" as="geometry"/>
                </mxCell>
                <mxCell id="S6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Cada proceso p recorre su bloque en orden:&lt;br&gt;desde p*per_proc hasta (p+1)*per_proc - 1&lt;br&gt;per_proc = 2^bits / size.&amp;nbsp;&lt;div&gt;&amp;nbsp;Ej.: la clave 2^54 es la primera del proceso 1&lt;/div&gt;" vertex="1">
                    <mxGeometry height="90" width="440" x="340" y="930" as="geometry"/>
                </mxCell>
                <mxCell id="qbTmCDqBDqGFpXAMGm0b-5" edge="1" parent="1" source="S7" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="FOUND">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="S7" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Encontrada?&#xa;(Allreduce MIN cada BATCH de pruebas)" vertex="1">
                    <mxGeometry height="110" width="300" x="410" y="1060" as="geometry"/>
                </mxCell>
                <mxCell id="FOUND" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="El proceso que la encontro envia el texto&#xa;descifrado a rank 0 (MPI_Send / MPI_Recv)" vertex="1">
                    <mxGeometry height="70" width="320" x="400" y="1205" as="geometry"/>
