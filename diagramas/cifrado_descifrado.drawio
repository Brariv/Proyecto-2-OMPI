    <diagram id="cifra-descifra" name="Cifrado y Descifrado AES-128">
        <mxGraphModel dx="1034" dy="1016" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="tC" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" value="CIFRADO   (aes_archivo -e)" vertex="1">
                    <mxGeometry height="40" width="340" x="40" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="tD" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" value="DESCIFRADO   (aes_archivo -d)" vertex="1">
                    <mxGeometry height="40" width="340" x="470" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="C0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Entrada:&#xa;clave numerica (-k)&#xa;archivo de texto (-i entrada.txt)&#xa;archivo de salida (-o cifrado.bin)" vertex="1">
                    <mxGeometry height="70" width="340" x="40" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="C1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Leer el texto desde entrada.txt" vertex="1">
                    <mxGeometry height="50" width="340" x="40" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="C2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="make_key(): construir la clave AES&#xa;de 16 bytes (128 bits) desde el entero -k" vertex="1">
                    <mxGeometry height="60" width="340" x="40" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="C3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Generar un IV aleatorio de 16 bytes&#xa;(RAND_bytes)" vertex="1">
                    <mxGeometry height="60" width="340" x="40" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="C4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Cifrar el texto con AES-128-CBC&#xa;y relleno PKCS#7" vertex="1">
                    <mxGeometry height="60" width="340" x="40" y="470" as="geometry"/>
                </mxCell>
                <mxCell id="C5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Escribir cifrado.bin:&#xa;[ IV (16 bytes) + texto cifrado ]" vertex="1">
                    <mxGeometry height="60" width="340" x="40" y="560" as="geometry"/>
                </mxCell>
                <mxCell id="C6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" value="Fin: archivo cifrado listo" vertex="1">
                    <mxGeometry height="50" width="340" x="40" y="650" as="geometry"/>
                </mxCell>
                <mxCell id="D0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Entrada:&#xa;clave numerica (-k)&#xa;archivo cifrado (-i cifrado.bin)&#xa;archivo de salida (-o recuperado.txt)" vertex="1">
                    <mxGeometry height="70" width="340" x="470" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="D1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Leer el archivo cifrado.bin" vertex="1">
                    <mxGeometry height="50" width="340" x="470" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="D2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="make_key(): misma clave AES&#xa;de 16 bytes (128 bits) desde el entero -k" vertex="1">
                    <mxGeometry height="60" width="340" x="470" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="D3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Separar el archivo:&#xa;primeros 16 bytes = IV&#xa;resto = texto cifrado" vertex="1">
                    <mxGeometry height="60" width="340" x="470" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="D4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Descifrar con AES-128-CBC&#xa;usando ese IV y la clave" vertex="1">
